{
  "name": "@gnaws/cli",
  "version": "0.1.0",
  "description": "GNAWS CLI — See what's beneath your cloud",
  "license": "AGPL-3.0-only",
  "keywords": [
    "aws",
    "aws-sdk",
    "cli",
    "cloud",
    "infrastructure",
    "inventory",
    "unused-resources",
    "cost-optimization",
    "graph"
  ],
  "homepage": "https://github.com/FabioDominio/gnaws-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioDominio/gnaws-cli.git"
  },
  "bugs": {
    "url": "https://github.com/FabioDominio/gnaws-cli/issues"
  },
  "files": [
    "dist",
    "sample-dump"
  ],
  "type": "module",
  "bin": {
    "gnaws": "./dist/app.js"
  },
  "scripts": {
    "build": "rm -rf dist && swc src/ -d dist --strip-leading-paths",
    "postbuild": "chmod +x dist/app.js",
    "dev": "tsx --env-file=.env src/app.ts",
    "start": "node --env-file=.env dist/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint --fix .",
    "test": "vitest run",
    "version": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s && git add CHANGELOG.md",
    "release": "bumpp",
    "prepare": "[ -d .git ] && husky || true"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1130.0",
    "@gnaws/core": "^0.2.0",
    "chalk": "^6.0.0",
    "graphology": "^0.26.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.5.1",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
